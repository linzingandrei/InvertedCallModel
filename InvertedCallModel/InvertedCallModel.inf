;
; InvertedCallModel.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = InvertedCallModel.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
InvertedCallModel.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%InvertedCallModel.DeviceDesc% = InvertedCallModel_Device, Root\InvertedCallModel ; TODO: edit hw-id

[InvertedCallModel_Device.NT]
CopyFiles = File_Copy

[File_Copy]
InvertedCallModel.sys

;-------------- Service installation
[InvertedCallModel_Device.NT.Services]
AddService = InvertedCallModel,%SPSVCINST_ASSOCSERVICE%, InvertedCallModel_Service_Inst

; -------------- InvertedCallModel driver install sections
[InvertedCallModel_Service_Inst]
DisplayName    = %InvertedCallModel.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\InvertedCallModel.sys

[InvertedCallModel_Device.NT.Wdf]
KmdfService = InvertedCallModel, InvertedCallModel_wdfsect

[InvertedCallModel_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "InvertedCallModel Installation Disk"
InvertedCallModel.DeviceDesc = "InvertedCallModel Device"
InvertedCallModel.SVCDESC = "InvertedCallModel Service"
